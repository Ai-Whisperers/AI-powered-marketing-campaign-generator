# Production Environment Configuration
# Copy this file to .env.production and fill in the values

# =============================================================================
# API Configuration
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=production

# Generate a secure API key: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=CHANGE_ME_GENERATE_SECURE_KEY

# =============================================================================
# Database Configuration (PostgreSQL)
# =============================================================================
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://maga_user:CHANGE_ME_SECURE_PASSWORD@postgres:5432/maga_prod

# PostgreSQL password (used by docker-compose)
POSTGRES_PASSWORD=CHANGE_ME_SECURE_PASSWORD

# =============================================================================
# Redis Configuration
# =============================================================================
REDIS_URL=redis://redis:6379/0

# =============================================================================
# AI Service API Keys
# =============================================================================
# OpenAI (required for GPT models)
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Anthropic (required for Claude models)
# Get key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Google (required for Gemini models)
# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=...

# Tavily (required for GPT Researcher)
# Get key: https://app.tavily.com/home
TAVILY_API_KEY=tvly-...

# =============================================================================
# Langfuse Configuration (Observability)
# =============================================================================
# Get keys: https://cloud.langfuse.com/
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# =============================================================================
# File Storage
# =============================================================================
PROJECTS_DIR=/app/data/projects

# =============================================================================
# Logging Configuration
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# =============================================================================
# Security Configuration
# =============================================================================
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Enable CORS
CORS_ENABLED=true

# Enable rate limiting
RATE_LIMIT_ENABLED=true

# =============================================================================
# Celery Configuration
# =============================================================================
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# =============================================================================
# Optional: Monitoring & Observability
# =============================================================================
# SENTRY_DSN=https://...
# PROMETHEUS_ENABLED=false
